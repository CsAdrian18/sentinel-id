# ============================================================================
# Sentinel ID — Environment Configuration Template
# Copy this file to .env and populate values for Live Mode or Gemini AI.
# NEVER commit your actual .env file to version control.
# ============================================================================

# --- Execution Mode & Safety Controls ---
# Default mode: "demo" (zero cloud access) or "live" (personal test Entra ID tenant)
SENTINEL_MODE=demo

# Threshold in days for flagging stale accounts (default: 90)
SENTINEL_STALE_DAYS=90

# Maximum recommended Global Administrators before flagging excess admins (default: 4)
SENTINEL_MAX_GLOBAL_ADMINS=4

# Remediation stays disabled by default (read-only mode).
# Even when enabled via CLI/UI, every action runs a dry-run first and requires explicit typed approval.
SENTINEL_ALLOW_REMEDIATION=false

# Salt used for deterministic SHA-256 PII pseudonymization before sending findings to Gemini
SENTINEL_REDACTION_SALT=sentinel-id-local-salt-change-me

# --- Gemini API Configuration (Optional in Demo Mode, Required for Live AI Generation) ---
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# --- Microsoft Entra ID (Live Mode — Personal Test Tenant ONLY) ---
# App Registration using Client Credentials (Read-Only permissions by default):
#   User.Read.All, Directory.Read.All, AuditLog.Read.All,
#   Policy.Read.All, RoleManagement.Read.Directory, IdentityRiskyUser.Read.All (optional)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=your-client-secret-value-here
ENTRA_TENANT_DOMAIN=contosotest.onmicrosoft.com
